local isEnabledTriple = false
local renderConnectionTriple = nil
local function getMultipleNearest(origin, maxDist, count)
    local targets = {}
    for i = 1, count do
        local best, bestDist = nil, maxDist * maxDist
        for _, target in ipairs(EntityManagerKA1.cache) do
            local skip = false
            for _, ex in ipairs(targets) do
                if ex == target then skip = true; break end
            end
            if not skip and target.character and not isWhitelisted(target.character) and target.hrp and target.humanoid and target.humanoid.Health > 0 then
                local pos = target.hrp.Position
                local distSq = (pos.X - origin.X)^2 + (pos.Y - origin.Y)^2 + (pos.Z - origin.Z)^2
                if distSq < bestDist then
                    bestDist = distSq; best = target
                end
            end
        end
        if best then table.insert(targets, best) else break end
    end
    return targets
end

local function attackLoopTriple()
    if not isEnabledTriple then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    EntityManagerKA1:refresh()
