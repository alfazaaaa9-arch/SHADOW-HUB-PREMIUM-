local WhitelistNames = {
    ["itz_shadow7862"] = true,
    ["prince1286099"] = true,
}

local function isWhitelisted(targetChar)
    if not targetChar then return false end
    
    -- 1. Check if it belongs to a Player
    local player = Players:GetPlayerFromCharacter(targetChar)
    if player then
        local nameLower = player.Name:lower()
        local dispLower = player.DisplayName:lower()
        if WhitelistNames[nameLower] or WhitelistNames[dispLower] then
            return true
        end
    end
    
    -- 2. Check directly by Model/Character name
    local charNameLower = targetChar.Name:lower()
    if WhitelistNames[charNameLower] then
        return true
    end
    
    return false
end

local function findRemoteKA1()
    local possiblePaths = {
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Game") and ReplicatedStorage.Game:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("Attack"),
    }
    for _, remote in ipairs(possiblePaths) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end
    local function deepScan(folder)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local name = child.Name:lower()
                if name:find("attack") or name:find("combat") or name:find("damage") or name:find("hit") or name:find("swing") then
                    return child
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local found = deepScan(child)
                if found then return found end
            end
        end
        return nil
    end
    return deepScan(ReplicatedStorage) or deepScan(Workspace)
end

local RemoteKA1 = findRemoteKA1()
local isRemoteEventKA1 = RemoteKA1 and RemoteKA1:IsA("RemoteEvent")

local EntityManagerKA1 = {
    cache = {},
    lastScan = 0,
    refresh = function(self)
        local newCache = {}
        -- Players Scan (Skip Whitelisted)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    if not isWhitelisted(char) then
                        table.insert(newCache, { character = char, hrp = char.HumanoidRootPart, humanoid = char.Humanoid })
                    end
                end
            end
        end
        -- Workspace NPCs / Models Scan (Skip Whitelisted)
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") and child ~= LocalPlayer.Character then
                local hrp = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Torso") or child:FindFirstChild("UpperTorso")
                local hum = child:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local plr = Players:GetPlayerFromCharacter(child)
                    if not plr or plr ~= LocalPlayer then
                        if not isWhitelisted(child) then
                            table.insert(newCache, { character = child, hrp = hrp, humanoid = hum })
                        end
                    end
                end
            end
        end
        self.cache = newCache
        self.lastScan = tick()
    end,
    getNearest = function(self, origin, maxDist)
        local best = nil
        local bestDist = maxDist * maxDist
        for _, target in ipairs(self.cache) do
            if target.character and not isWhitelisted(target.character) then
                if target.hrp and target.hrp.Position then
                    local dx = target.hrp.Position.X - origin.X
                    local dy = target.hrp.Position.Y - origin.Y
                    local dz = target.hrp.Position.Z - origin.Z
                    local distSq = dx*dx + dy*dy + dz*dz
                    if distSq < bestDist then
                        bestDist = distSq
                        best = target
                    end
                end
            end
        end
        return best
    end
}

local function fireAttack(targetChar)
    -- Absolute final barrier: If target is whitelisted, immediately abort!
    if not targetChar or isWhitelisted(targetChar) then return end

    if not RemoteKA1 then
        RemoteKA1 = findRemoteKA1()
        isRemoteEventKA1 = RemoteKA1 and RemoteKA1:IsA("RemoteEvent")
        if not RemoteKA1 then return end
    end
    
    pcall(function()
        if isRemoteEventKA1 then
            RemoteKA1:FireServer(targetChar)
            RemoteKA1:FireServer(targetChar, 1)
            RemoteKA1:FireServer(targetChar, targetChar:FindFirstChild("HumanoidRootPart"))
        else
            RemoteKA1:InvokeServer(targetChar)
            RemoteKA1:InvokeServer(targetChar, 1)
        end
    end)
end

