local godModeEnabled = false

local function nullifyRemote(networkFolder, remoteName)
    local realRemote = networkFolder:FindFirstChild(remoteName)
    if realRemote then
        local dummy = Instance.new("RemoteEvent")
        dummy.Name = remoteName
        dummy.Parent = networkFolder
        realRemote:Destroy()
    end
end

RunService.Heartbeat:Connect(function()
    if godModeEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end
end)

local function findAttackRemote()
    local possiblePaths = {
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Attack")
    }
    for _, remote in ipairs(possiblePaths) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end
    return ReplicatedStorage:FindFirstChild("Attack", true)
end

local KillAuraRemote = findAttackRemote()
local isKillAuraRemoteEvent = KillAuraRemote and KillAuraRemote:IsA("RemoteEvent")

local KillAuraManager = {
    cache = {},
    lastScan = 0,
    refresh = function(self)
        local newCache = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    table.insert(newCache, { character = char, hrp = char.HumanoidRootPart, humanoid = char.Humanoid })
                end
            end
        end
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") and child ~= LocalPlayer.Character then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                local hum = child:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    table.insert(newCache, { character = child, hrp = hrp, humanoid = hum })
                end
            end
        end
        self.cache = newCache
        self.lastScan = tick()
    end,
    getNearest = function(self, origin, maxDist)
        local best, bestDist = nil, maxDist * maxDist
        for _, target in ipairs(self.cache) do
            if target.hrp and target.hrp.Position then
                local distSq = (target.hrp.Position - origin).Magnitude ^ 2
                if distSq < bestDist then
                    bestDist = distSq
                    best = target
                end
            end
        end
        return best
    end
}

local killAuraEnabled = false
local killAuraConnection = nil
local lastAuraAttack = 0

local function runKillAuraLoop()
    if not killAuraEnabled or not KillAuraRemote then return end
    if tick() - lastAuraAttack < 0.15 then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if tick() - KillAuraManager.lastScan > 0.5 then
        KillAuraManager:refresh()
    end

    local target = KillAuraManager:getNearest(hrp.Position, 75)
    if not target then return end

    pcall(function()
        if isKillAuraRemoteEvent then
            KillAuraRemote:FireServer(target.character, 1)
        else
            KillAuraRemote:InvokeServer(target.character, 1)
        end
    end)
    lastAuraAttack = tick()
end

createToggle(TabCombat, "⚔️ SHADOW INSTA KILL AURA", function(state)
    killAuraEnabled = state
    if state then
        if not killAuraConnection then
            killAuraConnection = RunService.Heartbeat:Connect(runKillAuraLoop)
        end
